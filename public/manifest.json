{
  "manifest_version": 3,
  "name": "ListSync – Kijiji & Marketplace Manager",
  "short_name": "ListSync",
  "version": "1.0.0",
  "description": "Create a listing once, post it to Kijiji and Facebook Marketplace, get stale-listing reminders and refresh in one click.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": ["https://www.kijiji.ca/*", "https://www.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ListSync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kijiji.ca/*"],
      "js": ["content-kijiji.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content-facebook.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["https://www.kijiji.ca/*", "https://www.facebook.com/*"]
    }
  ]
}
