{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "popup": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/popup/main.ts",
            "tsConfig": "tsconfig.popup.json",
            "index": "src/popup/index.html",
            "outputPath": "dist-angular/popup",
            "outputMode": "static",
            "styles": [],
            "polyfills": [],
            "optimization": true,
            "outputHashing": "none",
            "sourceMap": false,
            "namedChunks": false,
            "extractLicenses": false,
            "budgets": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "dashboard": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/dashboard/main.ts",
            "tsConfig": "tsconfig.dashboard.json",
            "index": "src/dashboard/index.html",
            "outputPath": "dist-angular/dashboard",
            "outputMode": "static",
            "styles": [],
            "polyfills": [],
            "optimization": true,
            "outputHashing": "none",
            "sourceMap": false,
            "namedChunks": false,
            "extractLicenses": false,
            "budgets": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
